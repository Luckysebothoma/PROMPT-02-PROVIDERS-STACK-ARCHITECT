{
  "title": "AI Gateway - Provider & Model Observability",
  "uid": "ai-gateway-provider-registry",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Provider Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum by (provider, model) (rate(ai_gateway_provider_requests_total[5m]))",
          "legendFormat": "{{provider}} / {{model}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Provider Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (provider, model) (rate(ai_gateway_provider_errors_total[5m]))",
          "legendFormat": "{{provider}} / {{model}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Provider Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, provider) (rate(ai_gateway_provider_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider}} p95"
        }
      ]
    },
    {
      "id": 4,
      "title": "Tokens by Provider",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum by (provider) (rate(ai_gateway_provider_input_tokens_total[5m]))",
          "legendFormat": "{{provider}} input"
        },
        {
          "expr": "sum by (provider) (rate(ai_gateway_provider_output_tokens_total[5m]))",
          "legendFormat": "{{provider}} output"
        }
      ]
    },
    {
      "id": 5,
      "title": "Tokens by Model",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sum by (model) (rate(ai_gateway_provider_input_tokens_total[5m]))",
          "legendFormat": "{{model}} input"
        },
        {
          "expr": "sum by (model) (rate(ai_gateway_provider_output_tokens_total[5m]))",
          "legendFormat": "{{model}} output"
        }
      ]
    }
  ]
}
