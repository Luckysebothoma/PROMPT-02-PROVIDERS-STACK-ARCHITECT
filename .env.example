# ============================================================
# AI GATEWAY - ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---- Core service ----
PORT=8080
NODE_ENV=development
LOG_LEVEL=info

# ---- PostgreSQL ----
POSTGRES_HOST=ai-gateway-postgres-db
POSTGRES_PORT=5432
POSTGRES_DB=ai_gateway
POSTGRES_USER=ai_gateway
POSTGRES_PASSWORD=

# ---- Redis ----
REDIS_HOST=ai-gateway-redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- AI Provider Resolution Defaults ----
# These select which provider/model is used when a /v1/chat
# request does not explicitly specify one.
AI_DEFAULT_PROVIDER=groq
AI_DEFAULT_MODEL=

# ---- Groq Provider ----
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---- Gemini Provider (config only, adapter NOT implemented in Day 2) ----
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
